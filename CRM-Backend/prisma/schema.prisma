generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PerfilAcesso {
  Administrador
  Usuario
}

enum LeadStatus {
  Ativo
  Inativo
}

enum Prioridade {
  Baixa
  Media
  Alta
}

enum InteracaoTipo {
  Ligacao
  Email
  Reuniao
  Nota
  Registro
}

enum TarefaStatus {
  Pendente
  Concluida
}

enum PropostaStatus {
  Rascunho
  Enviada
  EmNegociacao
  Aceita
  Recusada
}

model Usuario {
  id            Int            @id @default(autoincrement())
  nome          String         @db.VarChar(120)
  email         String         @unique @db.VarChar(180)
  cargo         String         @db.VarChar(80)
  senha         String         @db.VarChar(255)
  perfilAcesso  PerfilAcesso   @default(Usuario) @map("perfil_acesso")
  avatarUrl     String?        @map("avatar_url") @db.Text
  ativo         Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  leads         Lead[]
  negocios      Negocio[]
  interacoes    Interacao[]
  tarefas       Tarefa[]
  propostas     Proposta[]

  @@map("usuario")
}

model MotivoPerda {
  id            Int            @id @default(autoincrement())
  nome          String         @unique @db.VarChar(120)
  ativo         Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  negocios      Negocio[]

  @@map("motivo_perda")
}

model Cargo {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(80)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cargo")
}

model EtapaFunil {
  id              Int                          @id @default(autoincrement())
  nome            String                       @unique @db.VarChar(80)
  ordem           Int                          @unique
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  negocios        Negocio[]
  historicoEtapas NegocioEtapaHistorico[]

  @@map("etapa_funil")
}

model Lead {
  id            Int            @id @default(autoincrement())
  nome          String         @db.VarChar(120)
  email         String?        @db.VarChar(180)
  telefone      String?        @db.VarChar(30)
  empresa       String?        @db.VarChar(120)
  cidade        String?        @db.VarChar(80)
  nicho         String?        @db.VarChar(80)
  observacoes   String?        @db.Text
  status        LeadStatus     @default(Ativo)
  dataCadastro  DateTime       @map("data_cadastro") @db.Date
  usuarioId     Int            @map("usuario_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  negocios      Negocio[]
  interacoes    Interacao[]
  tarefas       Tarefa[]

  @@index([usuarioId])
  @@index([dataCadastro])
  @@index([status])
  @@map("lead")
}

model Negocio {
  id              Int                     @id @default(autoincrement())
  titulo          String                  @db.VarChar(160)
  valorEstimado   Decimal                 @default(0) @map("valor_estimado") @db.Decimal(12, 2)
  prioridade      Prioridade              @default(Media)
  motivoPerdaId   Int?                    @map("motivo_perda_id")
  dataCriacao     DateTime                @default(now()) @map("data_criacao")
  leadId          Int                     @map("lead_id")
  etapaFunilId    Int                     @map("etapa_funil_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  responsaveis    Usuario[]
  lead            Lead                    @relation(fields: [leadId], references: [id])
  etapaFunil      EtapaFunil              @relation(fields: [etapaFunilId], references: [id])
  motivoPerda     MotivoPerda?            @relation(fields: [motivoPerdaId], references: [id], onDelete: SetNull)
  interacoes      Interacao[]
  tarefas         Tarefa[]
  propostas       Proposta[]
  historicoEtapas NegocioEtapaHistorico[]

  @@index([leadId])
  @@index([etapaFunilId])
  @@index([motivoPerdaId])
  @@map("negocio")
}

model NegocioEtapaHistorico {
  id           Int        @id @default(autoincrement())
  negocioId    Int        @map("negocio_id")
  etapaFunilId Int        @map("etapa_funil_id")
  entradaEm    DateTime   @map("entrada_em")
  saidaEm      DateTime?  @map("saida_em")
  createdAt    DateTime   @default(now()) @map("created_at")
  negocio      Negocio    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  etapaFunil   EtapaFunil @relation(fields: [etapaFunilId], references: [id])

  @@index([negocioId])
  @@index([etapaFunilId])
  @@index([entradaEm])
  @@map("negocio_etapa_historico")
}

model Proposta {
  id             Int            @id @default(autoincrement())
  titulo         String         @db.VarChar(160)
  valor          Decimal        @default(0) @db.Decimal(12, 2)
  status         PropostaStatus @default(Rascunho)
  dataProposta   DateTime       @map("data_proposta") @db.Date
  observacoes    String?        @db.Text
  negocioId      Int            @map("negocio_id")
  usuarioId      Int            @map("usuario_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  negocio        Negocio        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])

  @@index([negocioId])
  @@index([usuarioId])
  @@index([dataProposta])
  @@map("proposta")
}

model Tarefa {
  id             Int           @id @default(autoincrement())
  titulo         String        @db.VarChar(160)
  descricao      String?       @db.Text
  dataPrazo      DateTime      @map("data_prazo") @db.Date
  status         TarefaStatus  @default(Pendente)
  leadId         Int           @map("lead_id")
  negocioId      Int?          @map("negocio_id")
  usuarioId      Int           @map("usuario_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  negocio        Negocio?      @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([leadId])
  @@index([negocioId])
  @@index([usuarioId])
  @@index([dataPrazo])
  @@index([status])
  @@map("tarefa")
}

model Interacao {
  id             Int           @id @default(autoincrement())
  tipo           InteracaoTipo
  descricao      String        @db.Text
  dataInteracao  DateTime      @map("data_interacao")
  leadId         Int           @map("lead_id")
  negocioId      Int?          @map("negocio_id")
  usuarioId      Int           @map("usuario_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  negocio        Negocio?      @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([leadId])
  @@index([negocioId])
  @@index([usuarioId])
  @@index([dataInteracao])
  @@map("interacao")
}
